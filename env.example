# 0.0.0.0 serves the dashboard on the downstream network (192.168.111.0/24 and
# the hotspot). Use 127.0.0.1 when access should go through an SSH tunnel only.
NETPULSE_WEB_HOST=0.0.0.0
NETPULSE_WEB_PORT=8081
# Leave empty to auto-detect the USB wireless interface (wlx* / wlan1).
NETPULSE_UPLINK=
NETPULSE_GATEWAY=192.168.1.1
NETPULSE_TRAFFIC_FLUSH_SECONDS=60

# AdGuard links follow the current NetPulse hostname by default.
NETPULSE_ADGUARD_WEB_PORT=3000
NETPULSE_ADGUARD_WEB_SCHEME=http
# For a reverse proxy or separate server, optionally set an absolute HTTP(S) URL.
# NETPULSE_ADGUARD_WEB_URL=https://dns.example.com/
