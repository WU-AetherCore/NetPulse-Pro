#!/bin/sh
set -eu
. /etc/default/netpulse-router
: "${NETPULSE_UPLINK:?Set NETPULSE_UPLINK in /etc/default/netpulse-router}"
ip link show "$NETPULSE_UPLINK" >/dev/null
sysctl -q -w net.ipv4.ip_forward=1
for entry in eth0:192.168.111.0/24 wlan0:192.168.112.0/24; do
    interface=${entry%%:*}
    subnet=${entry#*:}
    iptables -t nat -C POSTROUTING -s "$subnet" -o "$NETPULSE_UPLINK" -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s "$subnet" -o "$NETPULSE_UPLINK" -j MASQUERADE
    iptables -C FORWARD -i "$interface" -o "$NETPULSE_UPLINK" -s "$subnet" -j ACCEPT 2>/dev/null || iptables -A FORWARD -i "$interface" -o "$NETPULSE_UPLINK" -s "$subnet" -j ACCEPT
    iptables -C FORWARD -i "$NETPULSE_UPLINK" -o "$interface" -d "$subnet" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || iptables -A FORWARD -i "$NETPULSE_UPLINK" -o "$interface" -d "$subnet" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
done
