#!/bin/sh
set -eu
sysctl -q -w net.ipv4.ip_forward=1
# Optional receive steering; run again after USB reconnection or route changes.
if [ -x /usr/local/sbin/netpulse-performance ]; then
    /usr/local/sbin/netpulse-performance >/dev/null || true
fi
# Choose the actual lowest-metric Wi-Fi default route, including fallback.
uplink=$(ip -j -4 route show default | python3 -c 'import json,sys; r=[x for x in json.load(sys.stdin) if x.get("dev") not in ("eth0","wlan0","lo","tailscale0")]; print(min(r,key=lambda x:x.get("metric",0))["dev"] if r else "")')
[ -n "$uplink" ] || exit 0
for entry in eth0:192.168.111.0/24 wlan0:192.168.112.0/24; do
    interface=${entry%%:*}
    subnet=${entry#*:}
    iptables -w 5 -t nat -C POSTROUTING -s "$subnet" -o "$uplink" -j MASQUERADE 2>/dev/null || iptables -w 5 -t nat -A POSTROUTING -s "$subnet" -o "$uplink" -j MASQUERADE
    iptables -w 5 -C FORWARD -i "$interface" -o "$uplink" -s "$subnet" -j ACCEPT 2>/dev/null || iptables -w 5 -A FORWARD -i "$interface" -o "$uplink" -s "$subnet" -j ACCEPT
    iptables -w 5 -C FORWARD -i "$uplink" -o "$interface" -d "$subnet" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT 2>/dev/null || iptables -w 5 -A FORWARD -i "$uplink" -o "$interface" -d "$subnet" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
done
