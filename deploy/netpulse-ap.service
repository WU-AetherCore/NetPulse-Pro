[Unit]
Description=NetPulse Pro onboard hotspot
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/ip link set wlan0 up
ExecStartPre=/usr/sbin/ip address replace 192.168.112.1/24 dev wlan0
ExecStart=/usr/sbin/hostapd /etc/hostapd/netpulse.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
